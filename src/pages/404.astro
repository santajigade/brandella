---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { getPosts } from '../lib/site';
const latest = (await getPosts()).slice(0, 6);
---
<Base title="Page not found" noindex>
  <section class="container narrow notfound">
    <p class="kicker">Error 404</p>
    <h1>We could not find that page</h1>
    <p>The link may be old or mistyped. Search the journal or start from one of our latest articles.</p>
    <form class="search-form" action="/search/" role="search"><input type="search" name="q" placeholder="Search articles" aria-label="Search articles" /></form>
  </section>
  <section class="container">
    <h2 class="section-label">Latest articles</h2>
    <div class="grid grid-3">{latest.map((p) => <Card post={p} />)}</div>
  </section>
</Base>
