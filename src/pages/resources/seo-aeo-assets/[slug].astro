---
import AssetPage from '../../../components/AssetPage.astro';
import ComingSoonAsset from '../../../components/ComingSoonAsset.astro';
import { liveAssets, allAssets, isLive } from '../../../lib/assets';

// Live assets get the full kit page. Assets not released yet get a noindex "coming soon" page
// (kept out of the sitemap in astro.config.mjs), which also replaces any older copy on the server.
export function getStaticPaths() {
  return [
    ...liveAssets.map((a) => ({ params: { slug: a.slug }, props: { a, m: null } })),
    ...allAssets.filter((m) => !isLive(m.slug)).map((m) => ({ params: { slug: m.slug }, props: { a: null, m } })),
  ];
}
const { a, m } = Astro.props as any;
---
{a ? <AssetPage a={a} /> : <ComingSoonAsset m={m} />}
