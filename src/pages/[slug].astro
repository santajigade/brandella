---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Sidebar from '../components/Sidebar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdSlot from '../components/AdSlot.astro';
import {
  getPosts, primaryCat, topCat, catUrl, catBySlug, authorOf, authorUrl, readTime,
  formatDate, related, nextUp, postUrl, headings, absolute, faqs,
} from '../lib/site';
import { SITE } from '../config';

export async function getStaticPaths() {
  const posts = await getPosts();
  const pages = await getCollection('pages');
  return [
    ...posts.map((p) => ({ params: { slug: p.data.slug }, props: { kind: 'post' as const, entry: p } })),
    ...pages.map((p) => ({ params: { slug: p.data.slug }, props: { kind: 'page' as const, entry: p } })),
  ];
}

const { kind, entry } = Astro.props;
const html = entry.rendered?.html ?? '';
const posts = await getPosts();

let post: any = null;
if (kind === 'post') {
  const p = entry as Awaited<ReturnType<typeof getPosts>>[number];
  const cat = primaryCat(p);
  const top = topCat(p);
  const author = authorOf(p);
  const toc = headings(html);
  const imageFile = (p.data.image ?? '').split('/').pop()?.replace(/\.[a-z]+$/i, '') ?? '';
  const imageBase = imageFile.replace(/-\d+x\d+$/, '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  // Hide the hero only when the body already shows the same image file or a sized or renamed copy of it (not when a heading id or link merely contains the name)
  const showHero = !!p.data.image && !(imageBase && new RegExp(`/${imageBase}[^"'\\s)]*\\.(webp|jpe?g|png|gif|avif)`, 'i').test(html.slice(0, 4000)));
  const crumbs = [
    ...(top.slug !== cat.slug ? [{ name: top.name, url: catUrl(top.slug) }] : []),
    { name: cat.name, url: catUrl(cat.slug) },
    { name: p.data.title, url: postUrl(p) },
  ];
  const updated = p.data.updated && formatDate(p.data.updated) !== formatDate(p.data.date) && p.data.updated > p.data.date ? p.data.updated : undefined;
  const schema = [{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${absolute(postUrl(p))}#article`,
    headline: p.data.title,
    description: p.data.description,
    image: p.data.image ? [absolute(p.data.image)] : undefined,
    datePublished: p.data.date.toISOString(),
    dateModified: (updated ?? p.data.date).toISOString(),
    author: { '@type': 'Person', '@id': `${SITE.url}/#author-${author.slug}`, name: author.name, jobTitle: author.role, url: absolute(authorUrl(author.slug)), image: author.photo ? absolute(author.photo) : undefined, sameAs: [author.linkedin], ...(author.expertise?.length ? { knowsAbout: author.expertise } : {}), ...(author.worksFor ? { worksFor: { '@type': 'Organization', name: author.worksFor.name, url: author.worksFor.url } } : {}), ...(author.education ? { hasCredential: { '@type': 'EducationalOccupationalCredential', credentialCategory: 'degree', name: author.education } } : {}) },
    publisher: { '@id': `${SITE.url}/#organization` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': absolute(postUrl(p)) },
    articleSection: cat.name,
    keywords: [p.data.focusKeyword, ...p.data.tags].filter(Boolean).join(', ') || undefined,
    wordCount: p.data.words,
    inLanguage: 'en',
  }];
  const qa = /"FAQPage"/.test(html) ? [] : faqs(html);
  if (qa.length >= 2) schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${absolute(postUrl(p))}#faq`,
    mainEntity: qa.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })),
  } as any);
  post = {
    p, cat, top, author, toc, showHero, crumbs, updated, schema,
    rel: related(posts, p, 4),
    readNext: p.data.takeaways?.length ? (posts.find((x: any) => x.data.slug === p.data.nextRead) ?? related(posts, p, 1)[0]) : undefined,
    next: nextUp(posts, p, 6).map((x) => postUrl(x)),
    shareUrl: encodeURIComponent(absolute(postUrl(p))),
    shareText: encodeURIComponent(p.data.title),
    initials: author.name.split(' ').map((w: string) => w[0]).join('').slice(0, 2),
  };
}
---
{post ? (
  <Base
    title={post.p.data.title}
    description={post.p.data.description}
    image={post.p.data.image}
    type="article"
    schema={post.schema}
    published={post.p.data.date}
    modified={post.updated}
    section={post.cat.name}
  >
    <article class="post" data-post-url={postUrl(post.p)} data-post-title={post.p.data.title}>
      <div class="container">
        <Breadcrumbs items={post.crumbs} />
        <header class="post-head">
          <a class="tag" href={catUrl(post.cat.slug)}>{post.cat.name}</a>
          <h1>{post.p.data.title}</h1>
          {post.p.data.description && <p class="dek">{post.p.data.description}</p>}
          <div class="byline">
            {post.author.photoSmall
              ? <img class="avatar" src={post.author.photoSmall} alt={post.author.name} width="44" height="44" />
              : <span class="avatar" aria-hidden="true">{post.initials}</span>}
            <div>
              <a class="byline-name" href={authorUrl(post.author.slug)}>{post.author.name}</a>
              <p class="meta">
                <time datetime={post.p.data.date.toISOString()}>{formatDate(post.p.data.date)}</time>
                {post.updated && <span>Updated <time datetime={post.updated.toISOString()}>{formatDate(post.updated)}</time></span>}
                <span>{readTime(post.p)} min read</span>
              </p>
            </div>
          </div>
          <div class="share" aria-label="Share this article">
            <span class="share-label">Share</span>
            <a class="share-btn share-wa" href={`https://wa.me/?text=${post.shareText}%20${post.shareUrl}`} target="_blank" rel="noopener nofollow" aria-label="Share on WhatsApp" title="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.4-.3z"/></svg></a>
            <a class="share-btn share-fb" href={`https://www.facebook.com/sharer/sharer.php?u=${post.shareUrl}`} target="_blank" rel="noopener nofollow" aria-label="Share on Facebook" title="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.5H16l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4a21 21 0 0 0-2.3-.1c-2.3 0-3.9 1.4-3.9 4v2.2H8v3h2.6V21z"/></svg></a>
            <a class="share-btn share-x" href={`https://twitter.com/intent/tweet?url=${post.shareUrl}&text=${post.shareText}`} target="_blank" rel="noopener nofollow" aria-label="Share on X" title="X"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.8 3h3l-6.6 7.6L22 21h-6.1l-4.8-6.3L5.6 21h-3l7.1-8.1L2.2 3h6.2l4.3 5.7zm-1 16.2h1.7L7.3 4.7H5.5z"/></svg></a>
            <a class="share-btn share-in" href={`https://www.linkedin.com/sharing/share-offsite/?url=${post.shareUrl}`} target="_blank" rel="noopener nofollow" aria-label="Share on LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.6c0-1.3 0-3-1.9-3s-2.2 1.5-2.2 2.9V21H9z"/></svg></a>
            <a class="share-btn share-tg" href={`https://t.me/share/url?url=${post.shareUrl}&text=${post.shareText}`} target="_blank" rel="noopener nofollow" aria-label="Share on Telegram" title="Telegram"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.6 4.2 18.4 19.4c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.3-5 9.2-8.3c.4-.4-.1-.6-.6-.2L5.8 13 1 11.5c-1-.3-1-1 .2-1.5L20.3 2.7c.9-.3 1.6.2 1.3 1.5z"/></svg></a>
            <button type="button" class="share-btn share-copy" data-url={absolute(postUrl(post.p))} aria-label="Copy link" title="Copy link"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M10.6 13.4a1 1 0 0 1 0-1.4l3.5-3.5a1 1 0 1 1 1.4 1.4L12 13.4a1 1 0 0 1-1.4 0zm-2.1 6.4a4.5 4.5 0 0 1-3.2-7.7l2.1-2.1a1 1 0 1 1 1.4 1.4l-2.1 2.1a2.5 2.5 0 0 0 3.5 3.5l2.1-2.1a1 1 0 1 1 1.4 1.4l-2.1 2.1a4.5 4.5 0 0 1-3.1 1.4zm7.4-5.9a1 1 0 0 1-.7-1.7l2.1-2.1a2.5 2.5 0 0 0-3.5-3.5l-2.1 2.1a1 1 0 0 1-1.4-1.4l2.1-2.1a4.5 4.5 0 0 1 6.4 6.4l-2.1 2.1a1 1 0 0 1-.8.2z"/></svg><span class="share-copied" aria-live="polite"></span></button>
          </div>
        </header>
      </div>
      <div class="container layout post-layout">
        <div class="main-col">
          {post.showHero && (
            <figure class="post-hero">
              <img src={post.p.data.image} alt={post.p.data.imageAlt || post.p.data.title} width="1200" height="675" fetchpriority="high" decoding="async" />
            </figure>
          )}
          {post.p.data.takeaways?.length > 0 && (
            <aside class="takeaways" aria-label="Key takeaways">
              <p class="takeaways-title">Key takeaways</p>
              <ul>{post.p.data.takeaways.map((t: string) => <li>{t}</li>)}</ul>
            </aside>
          )}
          {post.toc.length > 2 && (
            <details class="toc toc-inline">
              <summary>In this article</summary>
              <ol>{post.toc.map((h: { id: string; text: string }) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}</ol>
            </details>
          )}
          <div class="post-body" set:html={html} />
          {post.readNext && (
            <aside class="whats-next" aria-label="What to read next">
              <p class="whats-next-title">What's next</p>
              <a class="whats-next-link" href={postUrl(post.readNext)}>
                <span class="whats-next-kicker">Read next</span>
                <span class="whats-next-head">{post.readNext.data.title}</span>
              </a>
              <p class="whats-next-tools">Want to check your own site? Try our <a href="/tools/">free SEO tools</a>.</p>
            </aside>
          )}
          <section class="author-box" aria-label="About the author">
            <div class="author-box-photo">
              {post.author.photo
                ? <img src={post.author.photo} alt={post.author.name} width="120" height="120" loading="lazy" />
                : <span class="avatar avatar-lg" aria-hidden="true">{post.initials}</span>}
            </div>
            <div class="author-box-body">
              <p class="kicker">Written by</p>
              <h2 class="author-box-name"><a href={authorUrl(post.author.slug)}>{post.author.name}</a></h2>
              <p class="author-role">{post.author.role}</p>
              <p class="author-bio">{post.author.bio}</p>
              {post.author.expertise && (
                <ul class="author-tags">{post.author.expertise.map((e: string) => <li>{e}</li>)}</ul>
              )}
              <div class="author-actions">
                <a class="btn" href={authorUrl(post.author.slug)}>More articles by {post.author.name.split(' ')[0]}</a>
                <a class="btn-ghost btn-in" href={post.author.linkedin} rel="noopener me" target="_blank">
                  <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.6c0-1.3 0-3-1.9-3s-2.2 1.5-2.2 2.9V21H9z"/></svg>
                  Connect on LinkedIn
                </a>
              </div>
            </div>
          </section>
          {post.rel.length > 0 && (
            <section class="related">
              <h2 class="section-label">Related articles</h2>
              <div class="grid grid-2">{post.rel.map((r: any) => <Card post={r} />)}</div>
            </section>
          )}
        </div>
        <Sidebar exclude={post.p.id}>
          {post.toc.length > 2 && (
            <nav class="widget toc toc-side" aria-label="Table of contents">
              <h3 class="widget-title">In this article</h3>
              <ol>{post.toc.map((h: { id: string; text: string }) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}</ol>
            </nav>
          )}
        </Sidebar>
      </div>
    </article>
    <div class="next-loader" data-next={JSON.stringify(post.next)} aria-hidden="true"></div>
    <script is:inline src="/js/post.js" defer></script>
  </Base>
) : (
  <Base title={entry.data.title} description={entry.data.description || undefined}>
    <div class="container narrow">
      <Breadcrumbs items={[{ name: entry.data.title, url: `/${entry.data.slug}/` }]} />
      <header class="page-head"><h1>{entry.data.title}</h1></header>
      <div class="post-body page-body" set:html={html} />
    </div>
  </Base>
)}
