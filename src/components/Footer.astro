---
import { MENU, TOOL_CATEGORIES, TOOLS_URL, SITE } from '../config';
import { catBySlug, catUrl, categories } from '../lib/site';
import Logo from './Logo.astro';
const sections = MENU.map((s) => catBySlug.get(s)!);
const topics = categories.filter((c) => c.parent && c.count > 0).sort((a, b) => b.count - a.count).slice(0, 10);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a href="/" class="brand"><Logo /></a>
      <p>{SITE.description}</p>
      <div class="social">
        <a href={SITE.profiles[0].url} aria-label="Brandella Journal on LinkedIn" rel="noopener" target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.6c0-1.3 0-3-1.9-3s-2.2 1.5-2.2 2.9V21H9z"/></svg>
        </a>
        <a href={SITE.profiles[1].url} aria-label="Brandella Journal on Facebook" rel="noopener" target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v7h4v-7h3l.5-4h-3.5V8.8c0-.5.3-.8.5-.8z"/></svg>
        </a>
        <a href={SITE.profiles[2].url} aria-label="Brandella Journal on Instagram" rel="noopener" target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/></svg>
        </a>
        <a href={SITE.profiles[3].url} aria-label="Brandella Journal on Pinterest" rel="noopener" target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.3-5.4s-.3-.7-.3-1.6c0-1.5.9-2.7 2-2.7.9 0 1.4.7 1.4 1.6 0 1-.6 2.4-.9 3.7-.3 1.1.6 2 1.7 2 2 0 3.5-2.1 3.5-5.2 0-2.7-2-4.6-4.8-4.6-3.3 0-5.2 2.5-5.2 5 0 1 .4 2.1.9 2.7.1.1.1.2.1.3l-.3 1.4c-.1.2-.2.3-.4.2-1.5-.7-2.4-2.8-2.4-4.6 0-3.7 2.7-7.2 7.8-7.2 4.1 0 7.3 2.9 7.3 6.9 0 4.1-2.6 7.4-6.2 7.4-1.2 0-2.4-.6-2.7-1.4l-.8 2.8c-.3 1-1 2.3-1.5 3.1A10 10 0 1 0 12 2z"/></svg>
        </a>
        <a href={`mailto:${SITE.email}`} aria-label="Email">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M3 5h18v14H3zM3 6l9 7 9-7"/></svg>
        </a>
        <a href="/rss.xml" aria-label="RSS feed">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="19" r="2" fill="currentColor"/><path fill="none" stroke="currentColor" stroke-width="2.2" d="M3 11a10 10 0 0 1 10 10M3 4a17 17 0 0 1 17 17"/></svg>
        </a>
      </div>
    </div>
    <div class="footer-col">
      <h3>Sections</h3>
      <ul>{sections.map((c) => <li><a href={catUrl(c.slug)}>{c.name}</a></li>)}</ul>
    </div>
    <div class="footer-col">
      <h3>Topics</h3>
      <ul>{topics.map((c) => <li><a href={catUrl(c.slug)}>{c.name}</a></li>)}</ul>
    </div>
    <div class="footer-col">
      <h3>Free Tools</h3>
      <ul>
        {TOOL_CATEGORIES.map((t) => <li><a href={t.url}>{t.name}</a></li>)}
        <li><a href={TOOLS_URL}>All tools</a></li>
        <li><a href="/resources/seo-aeo-assets/">Free SEO and AEO Assets</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h3>Company</h3>
      <ul>
        <li><a href="/about-us/">About Us</a></li>
        <li><a href="/contact-page/">Contact</a></li>
        <li><a href="/author/santajigade/">Our Editor</a></li>
        <li><a href="/privacy-policy/">Privacy Policy</a></li>
        <li><a href="/terms-and-conditions/">Terms and Conditions</a></li>
        <li><a href="/rss.xml">RSS Feed</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container footer-bottom-in">
      <span>&copy; {year} {SITE.name}. All rights reserved.</span>
      <span><a href="/privacy-policy/">Privacy</a> <a href="/terms-and-conditions/">Terms</a> <a href="/sitemap-index.xml">Sitemap</a></span>
    </div>
  </div>
</footer>
