---
import { SITE } from '../config';
interface Props { format?: 'auto' | 'rectangle' | 'horizontal'; class?: string }
const { format = 'auto', class: cls } = Astro.props;
---
{SITE.adsenseClient && (
  <div class:list={['ad-slot', cls]}>
    <span class="ad-label">Advertisement</span>
    <ins class="adsbygoogle" style="display:block" data-ad-client={SITE.adsenseClient} data-ad-slot={SITE.adsenseSlot} data-ad-format={format} data-full-width-responsive="true"></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
