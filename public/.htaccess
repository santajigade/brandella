# Brandella Journal static site (Astro). Generated from the repo, edit there.
# IMPORTANT: /tools/ is deployed separately by santajigade/brandella-tools. Nothing here may break it.

DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

<IfModule LiteSpeed>
  CacheLookup off
</IfModule>
<IfModule mod_headers.c>
  Header set X-LiteSpeed-Cache-Control "no-cache"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force https and non www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://brandella.in/$1 [R=301,L,NE]

  # Old WordPress feeds
  RewriteRule ^feed/?$ /rss.xml [R=301,L]
  RewriteRule ^comments/feed/?$ /rss.xml [R=301,L]
  RewriteRule ^(.+)/feed/?$ /$1/ [R=301,L]

  # Old WordPress and Rank Math sitemaps
  RewriteRule ^(sitemap_index\.xml|sitemap\.xml|post-sitemap[0-9]*\.xml|page-sitemap[0-9]*\.xml|category-sitemap[0-9]*\.xml|post_tag-sitemap[0-9]*\.xml|author-sitemap[0-9]*\.xml|local-sitemap\.xml|sitemap-news\.xml|news-sitemap\.xml|wp-sitemap.*\.xml)$ /sitemap-index.xml [R=301,L]

  # WordPress admin and login endpoints
  RewriteRule ^wp-admin(/.*)?$ / [R=301,L]
  RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-signup\.php)$ / [R=301,L]

  # Tags were not migrated, theme demo pages removed
  RewriteRule ^tag/ / [R=301,L]
  RewriteRule ^category/uncategorized/?(.*)$ / [R=301,L]
  RewriteRule ^(sample-page|home|coming-soon|elementor-[0-9]+)/?$ / [R=301,L]
  RewriteRule ^author/admin/?(.*)$ /author/santajigade/$1 [R=301,L]
  RewriteRule ^page/[0-9]+/?$ / [R=301,L]

  # BEGIN post redirects (generated by scripts/migrate_wxr.py)
  RewriteRule ^ab\-testing\-subject\-lines/?$ /email-marketing-strategy/ [R=301,L]
  RewriteRule ^ai\-automation\-workflows\-every\-business\-should\-know\-in\-2026/?$ /ai-automation-workflows-every-business/ [R=301,L]
  RewriteRule ^ai\-seo\-specific\-content\-gets\-cited\-more/?$ /how-to-increase-ai-search-citations/ [R=301,L]
  RewriteRule ^competitor\-backlink\-analysis\-step\-by\-step\-guide/?$ /competitor-backlink-analysis/ [R=301,L]
  RewriteRule ^content\-marketing\-guide\-for\-seo/?$ /complete-content-marketing-strategy-guide-2026/ [R=301,L]
  RewriteRule ^core\-web\-vitals\-2026\-what\-changed/?$ /core-web-vitals-2026/ [R=301,L]
  RewriteRule ^crawl\-budget\-explained\-google\-ignoring\-site/?$ /crawl-budget-explained/ [R=301,L]
  RewriteRule ^digital\-marketing\-trends\-2026/?$ /digital-marketing-tips-2026/ [R=301,L]
  RewriteRule ^eeat\-explained\-experience\-expertise\-authority\-trust/?$ /eeat-experience-expertise-authority-trust/ [R=301,L]
  RewriteRule ^email\-segmentation\-strategies/?$ /email-marketing-strategy/ [R=301,L]
  RewriteRule ^google\-ads\-automation\-guide/?$ /category/paid-media/google-ads/ [R=301,L]
  RewriteRule ^google\-ads\-bidding\-change\-target\-cpa\-august\-2026/?$ /google-ads-bidding-change-target-cpa/ [R=301,L]
  RewriteRule ^google\-ads\-quality\-score\-explained\-guide/?$ /google-ads-quality-score-explained/ [R=301,L]
  RewriteRule ^google\-ads\-terms\-of\-service\-2026\-advertiser\-liability/?$ /google-ads-terms-of-service-2026/ [R=301,L]
  RewriteRule ^google\-business\-profile\-complete\-guide\-beginners/?$ /google-my-business-profile-complete-guide-beginners/ [R=301,L]
  RewriteRule ^google\-search\-algorithm\-updates\-2026/?$ /category/seo/ [R=301,L]
  RewriteRule ^how\-google\-crawls\-websites\-discovery\-indexing/?$ /how-google-crawls-websites/ [R=301,L]
  RewriteRule ^how\-to\-add\-schema\-markup\-json\-ld\-examples/?$ /how-to-add-schema-markup-json-ld/ [R=301,L]
  RewriteRule ^how\-to\-get\-more\-google\-reviews\-without\-breaking\-rules/?$ /how-to-get-more-google-reviews/ [R=301,L]
  RewriteRule ^how\-to\-optimize\-for\-ai\-overviews/?$ /ai-overviews-clicks-how-to-get-cited-2026/ [R=301,L]
  RewriteRule ^how\-to\-write\-seo\-friendly\-blog\-posts/?$ /how-to-write-seo-friendly-blog/ [R=301,L]
  RewriteRule ^indexnow\-explained\-help\-google\-index\-faster/?$ /indexnow-explained-can-it-help-google-index-faster/ [R=301,L]
  RewriteRule ^infinite\-scroll\-vs\-pagination/?$ /infinite-scroll-vs-pagination-7-real-javascript-differences/ [R=301,L]
  RewriteRule ^information\-gain\-seo\-explained\-examples/?$ /information-gain-seo-explained/ [R=301,L]
  RewriteRule ^linkedin\-marketing\-strategy\-b2b\-companies/?$ /linkedin-marketing-strategy/ [R=301,L]
  RewriteRule ^meta\-robots\-tags\-explained\-html\-examples/?$ /meta-robots-tags-explained-2/ [R=301,L]
  RewriteRule ^mobile\-seo\-checklist\-for\-faster\-rankings/?$ /mobile-seo-checklist-for-faster-rankings-2026/ [R=301,L]
  RewriteRule ^off\-page\-seo\-checklist\-2026/?$ /off-page-seo-checklist-for-2026/ [R=301,L]
  RewriteRule ^online\-retailers\-struggle\-as\-consumers\-cut\-discretionary\-spending/?$ /how-google-sge-is-changing-seo-2025/ [R=301,L]
  RewriteRule ^paid\-media\-strategy\-guide/?$ /category/paid-media/ [R=301,L]
  RewriteRule ^ppc\-best\-practices\-2026/?$ /25-google-ads-optimization-tips/ [R=301,L]
  RewriteRule ^programmatic\-seo\-2026\-why\-page\-volume\-stopped\-working/?$ /programmatic-seo-2026/ [R=301,L]
  RewriteRule ^robots\-txt\-explained\-complete\-guide\-examples/?$ /robots-txt-complete-guide/ [R=301,L]
  RewriteRule ^tech\-companies\-face\-backlash\-over\-ai\-powered\-surveillance/?$ /google-helpful-content-system-2025/ [R=301,L]
  RewriteRule ^utm\-parameters\-explained\-track\-campaigns/?$ /utm-parameters-explained/ [R=301,L]
  RewriteRule ^what\-is\-ai\-mode\-in\-google\-search/?$ /what-is-google-ai-mode/ [R=301,L]
  RewriteRule ^what\-is\-an\-ai\-agent\-guide\-for\-marketers\-2026/?$ /what-is-an-ai-agent/ [R=301,L]
  RewriteRule ^what\-is\-canonicalization\-fixing\-duplicate\-content/?$ /what-is-canonical-tag/ [R=301,L]
  RewriteRule ^what\-is\-first\-contentful\-paint\-fcp\-seo/?$ /what-is-first-contentful-paint-fcp/ [R=301,L]
  RewriteRule ^what\-is\-generative\-engine\-optimization\-geo/?$ /aeo-vs-seo-vs-geo-difference-2026/ [R=301,L]
  RewriteRule ^what\-is\-largest\-contentful\-paint\-lcp\-guide/?$ /what-is-largest-contentful-paint-lcp/ [R=301,L]
  RewriteRule ^what\-is\-link\-building\-complete\-beginners\-guide/?$ /what-is-link-building/ [R=301,L]
  RewriteRule ^what\-is\-schema\-markup\-seo\-ai\-search\-guide/?$ /what-is-schema-markup/ [R=301,L]
  RewriteRule ^what\-is\-search\-intent\-practical\-guide\-examples/?$ /what-is-search-intent-practical-guide/ [R=301,L]
  RewriteRule ^what\-is\-total\-blocking\-time\-tbt\-guide/?$ /what-is-total-blocking-time-tbt/ [R=301,L]
  # END post redirects

  # BEGIN manual redirects (kept by hand, not generated)
  RewriteRule ^meta\-robots\-tags\-explained/?$ /meta-robots-tags-explained-2/ [R=301,L]
  # Truncated or wrong URLs seen in Search Console (Nov 2026)
  RewriteRule ^august\-2026\-spam\-/?$ /august-2026-spam-update/ [R=301,L]
  RewriteRule ^linkedin\-ai\-search\-/?$ /linkedin-ai-search-citations/ [R=301,L]
  RewriteRule ^how\-to\-increase\-ai\-/?$ /how-to-increase-ai-search-citations/ [R=301,L]
  RewriteRule ^how\-to\-measure\-core\-web\-vitals/?$ /how-to-measure-core-web-vitals-tools-guide/ [R=301,L]
  RewriteRule ^en/(.+)$ /$1 [R=301,L]
  RewriteRule ^programmatic\-seo\-/?$ /programmatic-seo-2026/ [R=301,L]
  RewriteRule ^meta\-viewport\-tag\-/?$ /meta-viewport-tag-explained/ [R=301,L]
  RewriteRule ^7\-creative\-video\-/?$ /7-creative-video-marketing-ideas/ [R=301,L]
  # Duplicate topics merged (Nov 15 2026)
  RewriteRule ^toxic\-backlinks\-how\-to\-identify\-and\-remove\-them/?$ /how-to-identify-remove-toxic-backlinks-safely/ [R=301,L]
  RewriteRule ^seo\-aeo\-geo/?$ /aeo-vs-seo-vs-geo-difference-2026/ [R=301,L]
  # 404s from Search Console (Nov 16 2026)
  RewriteRule ^page/?$ / [R=301,L]
  RewriteRule ^answer\-engine\-optimization\-aeo/?$ /aeo-vs-seo-vs-geo-difference-2026/ [R=301,L]
  RewriteRule ^canonical\-tag\-explained/?$ /what-is-canonical-tag/ [R=301,L]
  RewriteRule ^why\-content\-quality\-matters\-more\-than\-quantity\-in\-seo/?$ /google-helpful-content-system-2025/ [R=301,L]
  RewriteRule ^seo\-in\-the\-age\-of\-ai\-how\-search\-is\-changing\-for\-marketers/?$ /3-ai-search-strategies-2026/ [R=301,L]
  RewriteRule ^digital\-marketing\-skills\-you\-need\-to\-succeed\-in\-the\-ai\-era/?$ /digital-marketing-tips-2026/ [R=301,L]
  RewriteRule ^how\-ai\-is\-transforming\-digital\-marketing/?$ /artificial-intelligence-transforming-digital-marketing/ [R=301,L]
  # END manual redirects

  # Push alerts: the only PHP file allowed to run
  RewriteRule ^api/subscribe\.php$ - [L]
  # Newsletter signup
  RewriteRule ^api/newsletter\.php$ - [L]
  # Block every PHP file (the old WordPress files stay on disk but must not run)
  RewriteRule \.php$ - [F,L]
</IfModule>

<FilesMatch "\.php$">
  Require all denied
</FilesMatch>

# Service worker and push script must always be fresh
<IfModule mod_headers.c>
  <FilesMatch "^(sw|push)\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType application/rss+xml "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.css$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Free asset library downloads: always open as a download, keep out of search results
  <FilesMatch "(-template\.csv|-prompts-checklist\.txt)$">
    Header set Content-Disposition "attachment"
    Header set X-Robots-Tag "noindex"
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>
